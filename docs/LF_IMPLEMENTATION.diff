+      const units = state.cart.filter(c => c.isReward && c.rewardPromotionId === promo.id).reduce((n, c) => n + c.quantity, 0)
+      if (due < 1 || units < 1 || units > due) invalid.push(promo.id)
+    }
+  }
+  return invalid
