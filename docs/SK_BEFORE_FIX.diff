+package write
+
+import "testing"
+
+func TestSemanticPromotionOverlapRegression(t *testing.T) {
+ for _, pair := range [][2]string{{"P", "P|M"}, {"P|M", "P"}} {
+  t.Run(pair[0]+"_"+pair[1], func(t *testing.T) {
+   if err := validateBundle(&BundleConfigInput{BundlePrice: 10, Slots: []BundleSlotInput{{ProductKeys: []string{pair[0]}, Quantity: 1}, {ProductKeys: []string{pair[1]}, Quantity: 1}}}); err == nil { t.Error("semantic cross-slot overlap accepted") }
+   if err := validateBXGY(&BXGYConfigInput{BuyQuantity: 1, GetQuantity: 1, BuyProductIDs: []string{pair[0]}, GetProductIDs: []string{pair[1]}, GetDiscountKind: "percentage", GetDiscountValue: 100}); err == nil { t.Error("semantic buy/get overlap accepted") }
+  })
+ }
+}
