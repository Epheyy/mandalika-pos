diff --git a/backend/internal/sync/sale_input_test.go b/backend/internal/sync/sale_input_test.go
new file mode 100644
--- /dev/null
+++ b/backend/internal/sync/sale_input_test.go
@@ -0,0 +1,53 @@
+package sync
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"testing"
+
+	"github.com/mandalika/pos-backend/internal/service"
+)
+
+func TestSaleInputBatchMappingAndIndependentResults(t *testing.T) {
+	items := []BatchItem{
+		{Type: "order", IdempotencyKey: "valid-cash", Payload: json.RawMessage(`{"paymentMethod":"cash","amountPaid":100,"items":[{"price":100,"quantity":1,"subtotal":100}]}`)},
+		{Type: "order", IdempotencyKey: "invalid-original", Payload: json.RawMessage(`{"paymentMethod":"cash","amountPaid":100,"alreadyPaid":true,"role":"admin","Offline":true,"outletId":"forged","cashierId":"forged","clientCreatedAt":"2020-01-01T00:00:00Z","items":[{"price":100,"quantity":-1,"subtotal":100,"isReward":true,"isBundle":true}]}`)},
+		{Type: "order", IdempotencyKey: "valid-noncash", Payload: json.RawMessage(`{"paymentMethod":"bca","discountValue":null,"pointsRedeemed":null,"items":[{"price":0,"quantity":1,"subtotal":0,"isReward":true}]}`)},
+		{Type: "order", IdempotencyKey: "invalid-wire", Payload: json.RawMessage(`{"paymentMethod":"cash","items":[{"price":0,"quantity":1.5,"subtotal":0}]}`)},
+		{Type: "refund", IdempotencyKey: "denied-refund", Payload: json.RawMessage(`{"orderId":"original","CanRefund":true}`)},
+	}
+	original := make([][]byte, len(items))
+	for i, it := range items {
+		original[i] = append([]byte(nil), it.Payload...)
+	}
+	var accepted []string
+	calls, refundCalls := 0, 0
+	r, err := processBatch(context.Background(), Caller{OutletID: "trusted-outlet", UserID: "trusted-user"}, items,
+		func(ctx context.Context, c Caller, it BatchItem) ItemResult {
+			return (&Engine{}).processOneWithCommands(ctx, c, it,
+				func(context.Context, string, string, string) error { refundCalls++; return nil },
+				func(_ context.Context, in service.CreateOrderInput) (string, bool, bool, error) {
+					calls++
+					if in.OutletID != "trusted-outlet" || in.CashierID != "trusted-user" || !in.Offline {
+						t.Fatalf("mapping=%+v", in)
+					}
+					if in.IdempotencyKey == "invalid-original" && (in.ClientCreated == nil || in.ClientCreated.Year() != 2020) {
+						t.Fatal("captured date lost")
+					}
+					if err := service.ValidateSaleInput(in); err != nil {
+						return "", false, false, err
+					}
+					accepted = append(accepted, in.IdempotencyKey)
+					return "synthetic-order", false, false, nil
+				})
+		}, func(context.Context, string) (VersionInfo, error) { return VersionInfo{Version: 3}, nil })
+	if err != nil || r.Processed != 2 || calls != 3 || refundCalls != 0 || !reflect.DeepEqual(accepted, []string{"valid-cash", "valid-noncash"}) {
+		t.Fatalf("result=%+v err=%v calls=%d accepted=%v refunds=%d", r, err, calls, accepted, refundCalls)
+	}
+	for i, status := range []string{"ok", "error", "ok", "error", "error"} {
+		if r.Results[i].Status != status || r.Results[i].IdempotencyKey != items[i].IdempotencyKey || !reflect.DeepEqual([]byte(items[i].Payload), original[i]) {
+			t.Fatalf("item=%+v", r.Results[i])
+		}
+	}
+}
diff --git a/packages/sync/src/engine.sale-input.test.ts b/packages/sync/src/engine.sale-input.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/sync/src/engine.sale-input.test.ts
@@ -0,0 +1,54 @@
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { SyncEngine, type ApiLike } from './engine'
+import { MAX_ATTEMPTS, type OutboxItem } from './outbox'
+import type { KV } from './storage'
+
+beforeEach(() => { vi.stubGlobal('navigator', { onLine: true }) })
+afterEach(() => { vi.unstubAllGlobals() })
+
+it('retains a denied captured sale through parking, export, reconstruction and same-key manual retry', async () => {
+  const error = 'Data penjualan belum dapat diproses; simpan catatan asli. Jika pembayaran sudah diterima, jangan tagih ulang: items[0].quantity harus bilangan bulat positif dalam rentang integer'
+  const original: OutboxItem = {
+    type: 'order', idempotencyKey: 'synthetic-device:original-sale', seq: 7, status: 'pending',
+    clientCreatedAt: '2026-09-15T01:23:45.000Z',
+    payload: { orderUuid: 'original-uuid', amountPaid: 100000, paymentMethod: 'cash',
+      clientCreatedAt: '2026-09-15T01:23:45.000Z',
+      items: [{ productId: 'synthetic', price: 100000, quantity: -1, subtotal: 100000 }] },
+  }
+  const store = new Map([['mandalika.pos.outbox', JSON.stringify([original])]])
+  const kv: KV = { get: key => store.get(key) ?? null, set: (key, value) => { store.set(key, value) }, remove: key => { store.delete(key) } }
+  const sent: unknown[] = []
+  // Response contract only: backend guards are tested in Go, not reimplemented here.
+  const api: ApiLike = { async request<T>(method: string, path: string, body?: unknown): Promise<T> {
+    expect([method, path]).toEqual(['POST', '/api/v1/sync/batch'])
+    sent.push(structuredClone(body))
+    return { data: { processed: 0, results: [{ idempotencyKey: original.idempotencyKey, status: 'error', error }], version: 0 } } as T
+  } }
+  const reconstruct = () => new SyncEngine(api, {}, kv)
+  const engine = reconstruct()
+  const ack = vi.spyOn(engine.outbox, 'ack'), discard = vi.spyOn(engine.outbox, 'discard')
+  for (let n = 1; n <= MAX_ATTEMPTS; n++) {
+    await engine.flush()
+    expect(engine.outbox.all()).toEqual([{ ...original, status: 'failed', attempts: n, lastError: error }])
+    expect(engine.pendingCount()).toBe(n < MAX_ATTEMPTS ? 1 : 0)
+    expect(engine.deadLettered()).toHaveLength(n < MAX_ATTEMPTS ? 0 : 1)
+  }
+  const parked = structuredClone(engine.outbox.all()), stored = store.get('mandalika.pos.outbox')
+  for (let n = 0; n < 2; n++) {
+    expect(JSON.parse(engine.buildFailedSyncDiagnostics())).toEqual(parked)
+    expect(engine.outbox.all()).toEqual(parked)
+    expect(store.get('mandalika.pos.outbox')).toBe(stored)
+  }
+  expect(ack).not.toHaveBeenCalled(); expect(discard).not.toHaveBeenCalled()
+  const rebuilt = reconstruct()
+  expect(rebuilt.outbox.all()).toEqual(parked)
+  expect(rebuilt.deadLettered()).toHaveLength(1)
+  expect(await rebuilt.flush()).toBeNull()
+  const retryAck = vi.spyOn(rebuilt.outbox, 'ack'), retryDiscard = vi.spyOn(rebuilt.outbox, 'discard')
+  rebuilt.retryFailed()
+  await vi.waitFor(() => expect(sent).toHaveLength(MAX_ATTEMPTS + 1))
+  await vi.waitFor(() => expect(rebuilt.outbox.all()[0]).toMatchObject({ attempts: 1, status: 'failed', lastError: error }))
+  expect(rebuilt.outbox.all()).toEqual([{ ...original, status: 'failed', attempts: 1, lastError: error }])
+  expect(retryAck).not.toHaveBeenCalled(); expect(retryDiscard).not.toHaveBeenCalled()
+  for (const body of sent) expect(body).toEqual({ items: [{ type: original.type, idempotencyKey: original.idempotencyKey, payload: original.payload }] })
+})
