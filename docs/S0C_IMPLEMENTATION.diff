+			t.Fatal(err)
+		}
+	}
+	const outlet = "00000000-0000-4000-8000-000000000001"
+	const user = "00000000-0000-4000-8000-000000000002"
+	const product = "00000000-0000-4000-8000-000000000003"
+	const customer = "00000000-0000-4000-8000-000000000004"
