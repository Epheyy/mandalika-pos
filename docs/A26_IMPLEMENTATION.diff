+++ b/backend/internal/handlers/pagination_integration_test.go
@@ -0,0 +1,195 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/mandalika/pos-backend/internal/auth"
+	"github.com/mandalika/pos-backend/internal/config"
+	"github.com/mandalika/pos-backend/internal/db"
+	mw "github.com/mandalika/pos-backend/internal/middleware"
+	"github.com/mandalika/pos-backend/internal/read"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// Fresh synthetic cluster only; exact target + data directory + empty schema.
+// Never loads application secrets or reuses a stopped historical fixture.
+func TestPaginationPostgres(t *testing.T) {
+	dsn := os.Getenv("MANDALIKA_A26_TEST_DSN")
+	if dsn == "" {
+		t.Skip("isolated A26 pagination PostgreSQL fixture not configured")
+	}
+	cfg, err := pgxpool.ParseConfig(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cfg.ConnConfig.Host != "127.0.0.1" || cfg.ConnConfig.Port != 56443 || cfg.ConnConfig.Database != "mandalika_a26_synthetic" || cfg.ConnConfig.User != "a26_test" {
+		t.Fatal("refusing non-fixture target")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+	defer cancel()
+	pool, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	var dir string
+	if err = pool.QueryRow(ctx, "SHOW data_directory").Scan(&dir); err != nil {
+		t.Fatal(err)
+	}
+	expected := os.Getenv("MANDALIKA_A26_TEST_DATA_DIR")
+	if expected == "" || filepath.Clean(dir) != filepath.Clean(expected) {
+		t.Fatal("fixture directory mismatch")
+	}
+	var tables int
+	if err = pool.QueryRow(ctx, "SELECT count(*) FROM information_schema.tables WHERE table_schema='public'").Scan(&tables); err != nil || tables != 0 {
+		t.Fatalf("fixture must be empty: tables=%d err=%v", tables, err)
+	}
+	if err = (&db.DB{Pool: pool}).Migrate(ctx); err != nil {
+		t.Fatal(err)
+	}
+	exec := func(sql string, args ...any) {
+		t.Helper()
+		if _, err := pool.Exec(ctx, sql, args...); err != nil {
+			t.Fatal(err)
+		}
+	}
+	const cashier = "00000000-0000-4000-8600-000000000001"
+	outletID := func(n int) string { return fmt.Sprintf("00000000-0000-4000-8601-%012d", n) }
+	shiftID := func(n int) string { return fmt.Sprintf("00000000-0000-4000-8602-%012d", n) }
+	for _, n := range []int{0, 51, 201, 1000} {
+		exec(`INSERT INTO outlets(id,name) VALUES($1,'A26 synthetic')`, outletID(n))
+		exec(`INSERT INTO shifts(id,outlet_id,cashier_id,cashier_name,status,opened_at) VALUES($1,$2,$3,'A26','open','2026-09-21T01:00:00Z')`, shiftID(n), outletID(n), cashier)
+		exec(`INSERT INTO orders(id,order_uuid,order_number,idempotency_key,outlet_id,cashier_id,cashier_name,subtotal,total,payment_method,status,shift_id,created_at)
+  SELECT ('00000000-0000-4000-8603-'||lpad(($4::int*10000+i)::text,12,'0'))::uuid,gen_random_uuid(),'A26-'||$4::text||'-'||i,'a26:'||$4::text||':'||i,$1,$2,'A26',1000,1000,'cash','completed',$3,'2026-09-21T02:00:00Z' FROM generate_series(1,$4::int) i`, outletID(n), cashier, shiftID(n), n)
+	}
+	exec(`INSERT INTO shifts(id,outlet_id,cashier_id,cashier_name,status,opened_at) SELECT ('00000000-0000-4000-8604-'||lpad(i::text,12,'0'))::uuid,$1,$2,'A26 past','closed','2026-09-20T01:00:00Z' FROM generate_series(1,250) i`, outletID(1000), cashier)
+	exec(`INSERT INTO cash_flows(id,outlet_id,shift_id,type,amount,description,created_at) SELECT ('00000000-0000-4000-8605-'||lpad(i::text,12,'0'))::uuid,$1,$2,'in',100,'A26 synthetic','2026-09-21T02:00:00Z' FROM generate_series(1,401) i`, outletID(1000), shiftID(1000))
+	exec(`INSERT INTO products(id,name,created_at) SELECT ('00000000-0000-4000-8606-'||lpad(i::text,12,'0'))::uuid,'A26 product '||i,'2026-09-21T02:00:00Z' FROM generate_series(1,201) i`)
+	exec(`INSERT INTO product_variants(product_id,size,price,stock,sku) SELECT id,'M',1000,10,'A26-'||id FROM products`)
+
+	h := New(read.New(pool), nil, nil, nil, nil, nil, nil)
+	secret := []byte("A26-SYNTHETIC-TEST-KEY")
+	wrap := mw.RequireAuth(&config.Config{AccessSecret: secret})
+	mux := http.NewServeMux()
+	mux.HandleFunc("/api/v1/orders", h.Orders)
+	mux.HandleFunc("/api/v1/shifts", h.Shifts)
+	mux.HandleFunc("/api/v1/cash-flows", h.CashFlows)
+	mux.HandleFunc("/api/v1/products", h.Products)
+	handler := wrap(mux)
+	fetch := func(t *testing.T, outlet, path string) json.RawMessage {
+		t.Helper()
+		token, err := auth.IssueAccess(secret, time.Hour, cashier, "cashier", outlet, []string{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		req := httptest.NewRequest(http.MethodGet, path, nil)
+		req.Header.Set("Authorization", "Bearer "+token)
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, req)
+		if w.Code != 200 {
+			t.Fatalf("GET %s: %d %s", path, w.Code, w.Body.String())
+		}
+		return append(json.RawMessage{}, w.Body.Bytes()...)
+	}
+	type row struct {
+		ID     string  `json:"id"`
+		Outlet string  `json:"outletId"`
+		Total  float64 `json:"total"`
+	}
+	type response struct {
+		Data []row                            `json:"data"`
+		Meta struct{ Total, Page, Limit int } `json:"meta"`
+	}
+	type record struct {
+		Name  string            `json:"name"`
+		Total int               `json:"total"`
+		Pages []json.RawMessage `json:"pages"`
+	}
+	records := []record{}
+	verify := func(t *testing.T, name, path string, n, total int, scoped bool) {
+		t.Helper()
+		record := record{Name: name, Total: total}
+		ids := map[string]bool{}
+		last := ""
+		sum := 0.0
+		for page := 1; page <= max(1, (total+199)/200); page++ {
+			raw := fetch(t, outletID(n), fmt.Sprintf("%s&page=%d&limit=200", path, page))
+			var r response
+			if err := json.Unmarshal(raw, &r); err != nil {
+				t.Fatal(err)
+			}
+			if r.Meta.Page != page || r.Meta.Limit != 200 || r.Meta.Total != total {
+				t.Fatalf("%s metadata %+v", name, r.Meta)
+			}
+			if len(r.Data) != min(200, total-(page-1)*200) {
+				t.Fatalf("%s row count %d", name, len(r.Data))
+			}
+			for _, v := range r.Data {
+				if ids[v.ID] {
+					t.Fatalf("%s duplicate %s", name, v.ID)
+				}
+				ids[v.ID] = true
+				// Orders/cash flows/products fixtures deliberately tie every timestamp.
+				if name != "shifts" && last != "" && last <= v.ID {
+					t.Fatalf("%s non-deterministic tie ordering", name)
+				}
+				last = v.ID
+				if scoped && v.Outlet != outletID(n) {
+					t.Fatalf("%s outlet scope escaped", name)
+				}
+				sum += v.Total
+			}
+			record.Pages = append(record.Pages, raw)
+		}
+		if len(ids) != total {
+			t.Fatal("incomplete IDs")
+		}
+		if name == fmt.Sprintf("orders-%d", n) && sum != float64(n*1000) {
+			t.Fatal("incomplete order total")
+		}
+		records = append(records, record)
+		t.Logf("%s: %d unique rows in %d pages; total=%.0f", name, total, len(record.Pages), sum)
+	}
+	for _, n := range []int{0, 51, 201, 1000} {
+		t.Run(fmt.Sprintf("orders-%d", n), func(t *testing.T) { verify(t, fmt.Sprintf("orders-%d", n), "/api/v1/orders?outletId=all", n, n, true) })
+		if n > 0 {
+			t.Run(fmt.Sprintf("old-limit-truncation-%d", n), func(t *testing.T) {
+				for _, limit := range []int{500, 1000} {
+					var r response
+					raw := fetch(t, outletID(n), fmt.Sprintf("/api/v1/orders?limit=%d", limit))
+					if err := json.Unmarshal(raw, &r); err != nil {
+						t.Fatal(err)
+					}
+					if len(r.Data) != 50 || r.Meta.Limit != 50 || r.Meta.Total != n {
+						t.Fatalf("legacy cap mismatch %+v", r.Meta)
+					}
+					t.Logf("request limit=%d receives50 of%d", limit, n)
+				}
+			})
+		}
+	}
+	t.Run("shifts-251", func(t *testing.T) { verify(t, "shifts", "/api/v1/shifts?", 1000, 251, true) })
+	t.Run("flows-401", func(t *testing.T) { verify(t, "flows", "/api/v1/cash-flows?shiftId="+shiftID(1000), 1000, 401, true) })
+	t.Run("products-201", func(t *testing.T) { verify(t, "products", "/api/v1/products?", 1000, 201, false) })
+	t.Run("shift-and-date-filters", func(t *testing.T) {
+		verify(t, "filtered", "/api/v1/orders?shiftId="+shiftID(201)+"&from=2026-09-21&to=2026-09-21", 201, 201, true)
+		verify(t, "empty-date", "/api/v1/orders?from=2026-09-22", 201, 0, true)
+		verify(t, "foreign-shift", "/api/v1/orders?shiftId="+shiftID(1000), 201, 0, true)
+	})
+	if path := os.Getenv("MANDALIKA_A26_TEST_OUTPUT"); path != "" {
+		raw, err := json.Marshal(records)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = os.WriteFile(path, append(raw, '\n'), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
diff --git a/scripts/a26-browser/README.md b/scripts/a26-browser/README.md
new file mode 100644
--- /dev/null
+++ b/scripts/a26-browser/README.md
@@ -0,0 +1,28 @@
+# A26 browser qualification
+
+These are Playwright tool function snippets, not standalone Node scripts. Run
+with `mcp__playwright__browser_run_code_unsafe` using the absolute filename.
+Installed local Vite apps use `VITE_API_URL=http://127.0.0.1:59999`, ports5174
+(Backoffice) and5173 (POS). All API responses are synthetic; external hosts are
+blocked. Do not point these fixtures at a live financial environment.
+
+1. `backoffice-setup.js` resets browser routes and synthetic local auth, seeds51
+   orders with the real server's200/default50 limit behavior, and captures CSV.
+   Before the fix this returned50 rows, after the fix51.
+2. `backoffice-checks.js` tests51/201/1000 orders, CSV/totals/filters, shift CSV,
+   dashboard/last-product stock, and failed-page export/error behavior.
+3. `transactions-checks.js` checks the Reports Transactions tab's XLSX and failure.
+   This replaces the Blob interceptor: rerun setup before repeating CSV tests.
+4. Run existing `scripts/a24-browser/setup.js` to establish the POS synthetic
+   cashier, then click Menu. Run `pos-recap.js` for401 orders/flows,251 history,
+   historical detail, later-page failures and same-storage offline panel remount.
+
+Use observed controls: current Backoffice Field labels are not associated with
+their inputs, so fixtures locate selects through their options. Currency assertions
+normalize nonbreaking spaces. HMR after source edits can remount the cashier;
+finish edits before running and re-open Menu when needed.
+
+Outputs in `docs/A26_BROWSER_*.json` are actual returned assertions/data. Browser
+fixtures verify rendered app wiring, not live API or native/printer qualification.
+Real authenticated handler/PostgreSQL evidence is separately captured by
+`TestPaginationPostgres`, with an explicit fresh loopback fixture and no secret fallback.
diff --git a/scripts/a26-browser/backoffice-checks.js b/scripts/a26-browser/backoffice-checks.js
new file mode 100644
--- /dev/null
+++ b/scripts/a26-browser/backoffice-checks.js
@@ -0,0 +1,43 @@
+async (page) => {
+  const results=[];
+  const check=(ok,msg)=>{if(!ok)throw new Error(msg);};
+  const capture=async()=>{await page.evaluate(()=>window.__a26csv=[]);await page.getByRole('button',{name:'Export CSV',exact:true}).click();return (await page.evaluate(()=>Promise.all(window.__a26csv)))[0];};
+  for(const n of [51,201,1000]) {
+    page.__a26.count=n;page.__a26.calls=[];
+    await page.getByRole('button',{name:'Dashboard',exact:true}).click();
+    await page.getByText(`${n} transaksi`,{exact:true}).waitFor();
+    const dashboard=await page.locator('main').innerText();
+    check(dashboard.includes(`Rp ${(n*1000).toLocaleString('id-ID')}`)||dashboard.replace(/\s/g,'').includes(`Rp${(n*1000).toLocaleString('id-ID')}`),'dashboard total');
+    check(dashboard.includes('Product 200'),'last-page low stock missing');
+    await page.getByRole('button',{name:'Laporan',exact:true}).click();
+    await page.getByRole('button',{name:'Ekspor',exact:true}).click();
+    await page.getByText(`${n} transaksi`,{exact:true}).waitFor();
+    const csv=await capture();const csvRows=csv.split('\n').length-1;
+    check(csvRows===n,`CSV ${csvRows} expected ${n}`);
+    const report=await page.locator('main').innerText();
+    check(report.replace(/\s/g,'').includes(`Rp${(n*1000).toLocaleString('id-ID')}`),'report total');
+    await page.locator('select').filter({has:page.locator('option[value="qris"]')}).selectOption('qris');
+    const filtered=await capture();check(filtered.split('\n').length-1===Math.floor(n/2),'payment filter');
+    await page.locator('select').filter({has:page.locator('option[value="refunded"]')}).selectOption('refunded');
+    check((await page.locator('main').innerText()).includes('0 transaksi'),'status filter');
+    await page.locator('select').filter({has:page.locator('option[value="refunded"]')}).selectOption('');
+    await page.locator('select').filter({has:page.locator('option[value="qris"]')}).selectOption('');
+    await page.locator('input[type=date]').first().fill('2099-01-01');
+    check((await page.locator('main').innerText()).includes('0 transaksi'),'date filter');
+    await page.locator('input[type=date]').first().fill(new Date().toISOString().slice(0,10));
+    await page.getByRole('button',{name:'Shift',exact:true}).click();
+    const shifts=await capture();check(shifts.split('\n').length-1===n,'shift CSV');
+    results.push({n,csvRows,shiftCsvRows:n,reportTotal:n*1000,filteredQris:Math.floor(n/2),dashboard,requests:page.__a26.calls});
+  }
+  await page.getByRole('button',{name:'Ekspor',exact:true}).click();
+  page.__a26.fail='/api/v1/orders';
+  await page.getByRole('alert').filter({hasText:'Gagal memuat data lengkap'}).waitFor({timeout:20000});
+  check(await page.getByRole('button',{name:'Export CSV',exact:true}).isDisabled(),'failed export enabled');
+  check((await page.locator('main').innerText()).includes('1000 transaksi'),'complete snapshot lost');
+  results.push({laterPageFailure:'visible error; original1000 snapshot retained; export disabled'});
+  await page.getByRole('button',{name:'Dashboard',exact:true}).click();
+  await page.getByRole('alert').filter({hasText:'Gagal memuat data lengkap'}).waitFor();
+  results.push({dashboardInitialFailure:'error instead of prefix KPIs'});
+  page.__a26.fail=null;
+  return results;
+}
diff --git a/scripts/a26-browser/backoffice-setup.js b/scripts/a26-browser/backoffice-setup.js
new file mode 100644
--- /dev/null
+++ b/scripts/a26-browser/backoffice-setup.js
@@ -0,0 +1,34 @@
+async (page) => {
+  await page.unrouteAll({behavior:'wait'});
+  const now = new Date().toISOString();
+  const user = {id:'synthetic-cashier',displayName:'A26 Cashier',role:'admin',outletId:'outlet-a',permissions:[]};
+  const order = i => ({id:`order-${i}`,orderNumber:`A26-${i}`,outletId:'outlet-a',cashierId:user.id,cashierName:user.displayName,customerId:null,customerName:null,status:'completed',paymentMethod:i%2?'qris':'cash',subtotal:1000,total:1000,discountAmount:0,taxAmount:0,createdAt:now,items:[{productId:'p',productName:'A26 Product',variantSize:'M',quantity:1,subtotal:1000,unitPrice:1000}]});
+  page.__a26 = {count:51,fail:null,calls:[],csv:[],order};
+  await page.context().route('**/*',route=>/^https?:\/\/(127\.0\.0\.1|localhost)(:|\/)/.test(route.request().url())?route.continue():route.abort());
+  await page.route('**/api/v1/**',async route=>{
+    const req=route.request(), path=req.url().replace(/^https?:\/\/[^/]+/,'').split('?')[0];
+    const query=Object.fromEntries((req.url().split('?')[1]||'').split('&').filter(Boolean).map(s=>s.split('=')));
+    const n=Number(query.page)||1, requested=Number(query.limit)||50, limit=requested>200||requested<1?50:requested;
+    const state=page.__a26;state.calls.push({path,page:n,requested,limit});
+    if(state.fail===path && n===2) return route.fulfill({status:503,json:{error:'A26 synthetic page 2 failure'}});
+    let data=[];
+    if(path.includes('/auth/')) data={access:'SYNTHETIC-NON-TOKEN',refresh:'SYNTHETIC-NON-TOKEN',user};
+    else if(path.endsWith('/outlets')) data=[{id:'outlet-a',name:'A26 Outlet',isActive:true}];
+    else if(path.endsWith('/orders')) data=Array.from({length:state.count},(_,i)=>order(i));
+    else if(path.endsWith('/shifts')) data=Array.from({length:state.count},(_,i)=>({id:`shift-${i}`,outletId:'outlet-a',cashierName:`Cashier ${i}`,status:'closed',openedAt:now,closedAt:now,startingCash:0,closingCash:1000,totalSales:1000,totalOrders:1,cashSales:1000,cardSales:0,transferSales:0,qrisSales:0}));
+    else if(path.endsWith('/products')) data=Array.from({length:201},(_,i)=>({id:`p-${i}`,name:`Product ${i}`,isActive:true,variants:[{size:'M',price:1000,stock:i===200?0:100}]}));
+    const total=Array.isArray(data)?data.length:1;
+    if(['/orders','/shifts','/products'].some(s=>path.endsWith(s))) data=data.slice((n-1)*limit,n*limit);
+    return route.fulfill({json:{data,meta:{total,page:n,limit}}});
+  });
+  await page.goto('http://127.0.0.1:5174');
+  await page.evaluate(()=>{localStorage.clear();localStorage.setItem('mandalika.backoffice.refresh','SYNTHETIC-NON-TOKEN');localStorage.setItem('mandalika.backoffice.loginDate',new Date().toISOString().slice(0,10));});
+  await page.reload();
+  await page.setViewportSize({width:1440,height:1000});
+  await page.getByRole('button',{name:'Laporan',exact:true}).click();
+  await page.getByRole('button',{name:'Ekspor',exact:true}).click();
+  await page.evaluate(()=>{window.__a26csv=[];URL.createObjectURL=b=>{window.__a26csv.push(b.text());return 'blob:synthetic';};HTMLAnchorElement.prototype.click=function(){};});
+  await page.getByRole('button',{name:'Export CSV',exact:true}).click();
+  const csv=await page.evaluate(()=>Promise.all(window.__a26csv));
+  return {expected:51,rows:csv[0]?.split('\n').length-1,calls:page.__a26.calls,body:(await page.locator('body').innerText()).slice(-1300)};
+}
diff --git a/scripts/a26-browser/pos-recap.js b/scripts/a26-browser/pos-recap.js
new file mode 100644
--- /dev/null
+++ b/scripts/a26-browser/pos-recap.js
@@ -0,0 +1,53 @@
+async(page)=>{
+  const now=new Date().toISOString();
+  const shift={id:'a26-active',outletId:'synthetic',outletName:'Synthetic Outlet',cashierId:'synthetic',cashierName:'Synthetic Cashier',openedAt:now,status:'open',startingCash:1100000,totalSales:401000,totalOrders:401,cashSales:401000,cardSales:0,qrisSales:0,transferSales:0};
+  page.__a26pos={fail:null,offline:false,calls:[]};
+  const routeHandler=async route=>{
+    const path=route.request().url().replace(/^https?:\/\/[^/]+/,'').split('?')[0];
+    const query=Object.fromEntries((route.request().url().split('?')[1]||'').split('&').filter(Boolean).map(s=>s.split('=')));
+    const pageNo=Number(query.page)||1,limit=Number(query.limit)||200,state=page.__a26pos;
+    state.calls.push({path,page:pageNo,limit});
+    if(state.offline||(state.fail===path&&pageNo===2))return route.fulfill({status:503,json:{error:'A26 unavailable page'}});
+    if(path.endsWith('/current'))return route.fulfill({json:{data:shift}});
+    const rows=path.endsWith('/shifts')?Array.from({length:251},(_,i)=>({...shift,id:`history-${i}`,cashierName:`Historical ${i}`,status:'closed',closedAt:now})):
+      path.endsWith('/orders')?Array.from({length:401},(_,i)=>({id:`order-${i}`,status:'completed',paymentMethod:'cash',total:1000,subtotal:1000,discountAmount:0,taxAmount:0,createdAt:now,items:[{productId:'p',productName:'Synthetic Scent',variantSize:'M',quantity:1,subtotal:1000}]})):
+      Array.from({length:401},(_,i)=>({id:`flow-${i}`,type:i%2?'out':'in',amount:100,description:`Synthetic flow ${i}`,createdAt:now}));
+    return route.fulfill({json:{data:rows.slice((pageNo-1)*limit,pageNo*limit),meta:{page:pageNo,limit,total:rows.length}}});
+  };
+  for(const part of ['orders','shifts','cash-flows'])await page.route(`**/api/v1/${part}**`,routeHandler);
+  await page.getByRole('button',{name:'Rekapan',exact:true}).click();
+  await page.getByText('201 Uang Masuk',{exact:true}).waitFor();
+  const active=await page.locator('body').innerText();
+  if(!active.replace(/\s/g,'').includes('Rp401.000'))throw new Error('active total not complete');
+  await page.getByRole('button',{name:'Riwayat',exact:true}).last().click();
+  await page.getByText('Historical 0',{exact:true}).waitFor();
+  // Existing client history pagination still reaches rows past the old 50 cutoff.
+  for(let i=0;i<3;i++)await page.getByRole('button',{name:'›',exact:true}).click();
+  await page.getByText('Historical 60',{exact:true}).first().click();
+  await page.getByText('Kas Masuk',{exact:true}).waitFor();
+  const historical=await page.locator('body').innerText();
+  const cache=await page.evaluate(()=>Object.fromEntries(Object.keys(localStorage).filter(k=>k.startsWith('mandalika.cache.rekap:')).map(k=>[k,localStorage.getItem(k)])));
+  const activeData=JSON.parse(cache['mandalika.cache.rekap:current']).data;
+  const historyData=JSON.parse(cache['mandalika.cache.rekap:history']).data;
+  const selectedData=JSON.parse(cache['mandalika.cache.rekap:orders:history-60']).data;
+  if(activeData.orders.length!==401||activeData.flows.length!==401||historyData.length!==251||selectedData.orders.length!==401||selectedData.flows.length!==401)throw new Error('cache incomplete');
+  page.__a26pos.fail='/api/v1/cash-flows';
+  await page.getByText('Historical 60',{exact:true}).first().click();
+  await page.getByText('Data belum diperbarui — menampilkan snapshot lengkap terakhir',{exact:true}).waitFor();
+  await page.getByRole('button',{name:'Rekapan',exact:true}).last().click();
+  await page.getByText('Data belum diperbarui — menampilkan snapshot lengkap terakhir',{exact:true}).waitFor();
+  const failedCache=await page.evaluate(()=>localStorage.getItem('mandalika.cache.rekap:current'));
+  if(failedCache!==cache['mandalika.cache.rekap:current'])throw new Error('partial cache overwritten');
+  // Unmount/remount the real panel, retaining successful storage and failing every recap request.
+  page.__a26pos.offline=true;
+  await page.getByRole('button',{name:'✕ Kembali ke Kasir',exact:true}).click();
+  await page.getByRole('button',{name:'Menu',exact:true}).click();
+  await page.getByRole('button',{name:'Rekapan',exact:true}).click();
+  await page.getByText('201 Uang Masuk',{exact:true}).waitFor();
+  await page.getByText('Data belum diperbarui — menampilkan snapshot lengkap terakhir',{exact:true}).waitFor();
+  await page.getByRole('button',{name:'Riwayat',exact:true}).last().click();
+  await page.getByText('Historical 0',{exact:true}).waitFor();
+  const finalCache=await page.evaluate(()=>Object.fromEntries(Object.keys(localStorage).filter(k=>k.startsWith('mandalika.cache.rekap:')).map(k=>[k,localStorage.getItem(k)])));
+  if(JSON.stringify(cache)!==JSON.stringify(finalCache))throw new Error('failed/offline reads modified cache');
+  return {active,historical,cacheCounts:{activeOrders:401,activeFlows:401,history:251,historicalOrders:401,historicalFlows:401},failure:'visible stale notice; unchanged complete bytes',reconstruction:'same storage; actual panel remount offline',calls:page.__a26pos.calls};
+}
diff --git a/scripts/a26-browser/transactions-checks.js b/scripts/a26-browser/transactions-checks.js
new file mode 100644
--- /dev/null
+++ b/scripts/a26-browser/transactions-checks.js
@@ -0,0 +1,25 @@
+async(page)=>{
+  const results=[];
+  for(const n of [51,201,1000]) {
+    page.__a26.count=n;
+    await page.getByRole('button',{name:'Dashboard',exact:true}).click();
+    await page.getByRole('button',{name:'Laporan',exact:true}).click();
+    await page.getByText(`${n} transaksi · Total:`,{exact:false}).waitFor();
+    await page.evaluate(()=>{window.__a26blobs=[];URL.createObjectURL=b=>{window.__a26blobs.push(b);return 'blob:synthetic';};});
+    await page.getByRole('button',{name:'Export',exact:true}).click();
+    const rows=await page.evaluate(async()=>{
+      const url=performance.getEntriesByType('resource').map(e=>e.name).find(n=>n.includes('/xlsx.js'));
+      const XLSX=await import(url);
+      const wb=XLSX.read(await window.__a26blobs[0].arrayBuffer());
+      return XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
+    });
+    if(rows.length!==n||rows.reduce((s,r)=>s+r.Total,0)!==n*1000)throw new Error('incomplete XLSX');
+    results.push({n,xlsxRows:rows.length,total:rows.reduce((s,r)=>s+r.Total,0)});
+  }
+  page.__a26.fail='/api/v1/orders';
+  await page.getByRole('alert').filter({hasText:'Gagal memuat data lengkap'}).waitFor({timeout:20000});
+  if(!(await page.getByRole('button',{name:'Export',exact:true}).isDisabled()))throw new Error('failure enabled export');
+  results.push({laterFailure:'visible error; XLSX disabled; complete snapshot retained'});
+  page.__a26.fail=null;
+  return results;
+}
