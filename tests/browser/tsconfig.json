{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "types": ["node"],
    "strict": true, "noImplicitAny": false, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["./**/*.ts"]
}
