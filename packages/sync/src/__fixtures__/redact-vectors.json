    "o": "ORD-0812345678901",
    "w": "a_0812345678901"
   },
   "expected": {
    "u": "e3b0c442-98fc-1c14-9afb-f4c8996fb924",
    "v": "0812345678-aaaa-bbbb-cccc-0123456789ab",
    "o": "ORD-0812345678901",
    "w": "a_0812345678901"
   }
  },
  {
   "name": "logs: exempt key still gets secret patterns",
   "tier": "logs",
   "input": {
    "idempotencyKey": "Bearer abc"
   },
   "expected": {
    "idempotencyKey": "Bearer [REDACTED]"
   }
  },
  {
   "name": "logs: Bearer and URL token",
   "tier": "logs",
   "input": {
    "m": "GET /x?access_token=abc failed, Bearer zzz.yyy"
   },
   "expected": {
    "m": "GET /x?access_token=[REDACTED] failed, Bearer [REDACTED]"
   }
  },
  {
   "name": "logs: top-level string",
   "tier": "logs",
   "input": "call 081234567890",
   "expected": "call [REDACTED]"
  },
  {
   "name": "secrets: Bearer is case-insensitive",
   "tier": "secrets",
   "input": {
    "m": "got bearer abc123 and BEARER xyz"
   },
   "expected": {
    "m": "got Bearer [REDACTED] and Bearer [REDACTED]"
   }
  },
  {
   "name": "secrets: Authorization Basic, but not the word Basic alone",
   "tier": "secrets",
   "input": {
