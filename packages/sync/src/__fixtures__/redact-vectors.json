   },
   "expected": {
    "ab": "xy"
   }
  },
  {
   "name": "logs: U+2028 text near the size cap is measured identically (5 fields x 2000 chars, not truncated)",
   "tier": "logs",
   "input": {
    "a": "{{2000* }}",
    "b": "{{2000* }}",
    "c": "{{2000* }}",
    "d": "{{2000* }}",
    "e": "{{2000* }}"
   },
   "expected": {
    "a": "{{2000* }}",
    "b": "{{2000* }}",
    "c": "{{2000* }}",
    "d": "{{2000* }}",
    "e": "{{2000* }}"
   }
  },
  {
   "name": "logs: over the size estimate collapses to a truncation marker",
