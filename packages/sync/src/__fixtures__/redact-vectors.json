   }
  },
  {
   "name": "secrets: JSON serialised inside a string",
   "tier": "secrets",
   "input": {
    "m": "body {\"pin\":\"1234\",\"Password\": \"p w\",\"token\":99,\"ok\":\"y\"}"
   },
   "expected": {
    "m": "body {\"pin\":\"[REDACTED]\",\"Password\":\"[REDACTED]\",\"token\":\"[REDACTED]\",\"ok\":\"y\"}"
   }
  },
  {
   "name": "logs: phone numbers with separators",
   "tier": "logs",
   "input": {
    "a": "0812 3456 7890",
    "b": "0812-3456-7890",
    "c": "+62 812-3456-7890",
    "d": "+62 81234567890",
    "e": "62-812-3456-7890",
    "f": "0812.3456.7890",
    "g": "(0812) 3456 7890",
    "h": "hubungi 0812 3456 7890, terima kasih"
   },
   "expected": {
    "a": "[REDACTED]",
    "b": "[REDACTED]",
    "c": "[REDACTED]",
    "d": "[REDACTED]",
    "e": "[REDACTED]",
    "f": "[REDACTED]",
    "g": "([REDACTED]",
    "h": "hubungi [REDACTED], terima kasih"
   }
  },
  {
   "name": "logs negative: receipts, dates, barcodes, epoch and long hyphenated codes",
   "tier": "logs",
   "input": {
