<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the gold Mandalika "M" mark centred inside the
     108dp canvas, sized to sit within the ~72dp safe zone so the launcher mask
     never clips it. Single bitmap (drawable/ic_logo_mark) scaled here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="60dp"
        android:height="38dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_logo_mark"
            android:gravity="center" />
    </item>
</layer-list>
