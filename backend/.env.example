# Server
PORT=8080
ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PostgreSQL
# container maps to 5433 to avoid clashing with a host-installed Postgres on 5432
DATABASE_URL=postgres://mandalika:mandalika@localhost:5433/mandalika_pos?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (generate strong random secrets — never commit real values)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=168

# Bootstrap admin (seed CLI)
SEED_ADMIN_EMAIL=admin@mandalika.local
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Administrator

# Cloudinary (signed uploads brokered by backend — Phase C)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error tracking (optional; no-op when empty — dev/CI need no Sentry).
SENTRY_DSN=

# Per-IP rate limit. RPS is converted to a per-minute window globally;
# auth endpoints are independently capped at 10/min.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
