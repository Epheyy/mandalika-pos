# Production environment — TEMPLATE ONLY. Never commit real values.
# These go into the host secret store (Fly: `fly secrets set KEY=VALUE`),
# NOT a committed .env. `cfg.Validate()` rejects every dev default below
# when ENV=production, so the server refuses to boot misconfigured.

ENV=production
PORT=8080

# Exact frontend + native origins. HTTPS only, no localhost, no wildcard.
# Capacitor Android WebView origin is https://localhost — allowed because
# allowMixedContent=false makes it a secure context calling the HTTPS API.
CORS_ORIGINS=https://admin.<your-domain>,https://localhost

# Managed Postgres (Neon). Pooled connection string, TLS required.
DATABASE_URL=postgres://<user>:<pass>@<project>-pooler.<region>.aws.neon.tech/mandalika_pos?sslmode=require

# Managed Redis (Upstash). rediss:// = TLS.
REDIS_URL=rediss://default:<pass>@<endpoint>.upstash.io:6379

# Generate with: ../scripts/gen-secrets.sh   (64 hex chars each, must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_HOURS=168

# First admin login, created by `cmd/seed`. Strong password; rotate after.
SEED_ADMIN_EMAIL=admin@<your-domain>
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SENTRY_DSN=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Trusted proxies appending to X-Forwarded-For, counted from the right.
#   1 = Cloud Run default *.run.app URL (Google front end appends one entry)
#   2 = behind an external HTTPS load balancer (it appends client + LB)
#   0 = local dev / direct connections (ignore X-Forwarded-For)
# Values above 10 are rejected at startup; above 2 logs a warning.
TRUSTED_PROXY_HOPS=1
