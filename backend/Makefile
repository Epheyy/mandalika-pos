.PHONY: tidy run seed up down test gen gen-go gen-ts gen-check gen-erp vet fmt migrate-fs migrate-fs-dry

up:
	docker compose up -d

down:
	docker compose down

tidy:
	go mod tidy

run:
	go run ./cmd/server

seed:
	go run ./cmd/seed

test:
	go test ./...

vet:
	go vet ./...

fmt:
	gofmt -l -w .

# Regenerate Go DTOs + chi/strict server from the OpenAPI contract.
gen-go:
	go run ./cmd/codegen

# Regenerate the TypeScript client (requires monorepo + pnpm, Phase B task 15).
gen-ts:
	cd .. && pnpm --filter @mandalika/api gen

# Phase F cutover — Firestore export → Postgres. EXPORT=path to export.json.
migrate-fs-dry:
	go run ./cmd/migrate-firestore --input $(EXPORT) --dry-run

migrate-fs:
	go run ./cmd/migrate-firestore --input $(EXPORT)

gen: gen-go gen-ts

# Validate frozen inputs and compare generated bytes without rewriting the checkout.
gen-check:
	go run ./cmd/codegen -check

# Regenerate the ERP Integration API v1 client from the 3.0 down-conversion (see api/erp/SOURCE.md).
gen-erp:
	cd internal/integration/erp/erpapi && go tool oapi-codegen -config oapi-codegen.yaml ../../../../api/erp/openapi.v1.as30.json
